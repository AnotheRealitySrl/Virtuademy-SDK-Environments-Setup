.h1 {
}

/* Brand header, in the manner of the Ready Player Me setup window. The logo image is set
   from code, because which of the two variants is readable depends on the editor skin:
   virtuademy-logo-light.png (light lettering) on the dark skin, virtuademy-logo-dark.png on
   the light one. Both are rasterized from the Landing's themes/virtuademy/full-*.svg. */
.window-header {
    align-items: center;
    padding-top: 12px;
    padding-bottom: 8px;
}

.header-logo {
    width: 100%;
    max-width: 320px;
    height: 50px;
    -unity-background-scale-mode: scale-to-fit;
}

.header-subtitle {
    margin-top: 4px;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
}

.separator {
    background-color: rgb(0, 0, 0);
    height: 1px;
}

.settings-item {
    padding-top: 0;
    padding-bottom: 0;
    margin-top: 2px;
    margin-bottom: 2px;
    padding-right: 0;
    padding-left: 0;
    align-items: center;
    flex-direction: row;
}

/* Both icons ship inside this package, and the paths are relative so they carry no
   asset GUID and no dependency on another package.
   They used to point at Check.png in com.unity.multiplayer.center and
   iconconflicted.png in com.unity.collab-proxy — two packages this one has nothing
   to do with and does not declare. In a project that happens to have them, as
   Virtuademy-Unity does, it worked; in a creator's project the URLs did not resolve,
   so every icon fell back to the missing-asset placeholder and rendered as the same
   yellow warning triangle whatever the underlying state was. */
.settings-item-green-icon {
    background-image: url("../Icons/check.png");
    width: 20px;
    height: 20px;
    align-self: center;
}

.settings-item-red-icon {
    background-image: url("../Icons/error.png");
    width: 20px;
    height: 20px;
    align-self: center;
}

.settings-group {
    flex-direction: row;
    justify-content: space-between;
}

.advanced-settings-item {
    align-self: flex-start;
}

.settings-button-container {
    max-height: 20px;
    margin-right: 4px;
    margin-left: 4px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.warning-item {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-left-color: rgba(0, 0, 0, 0.5);
    border-right-color: rgba(0, 0, 0, 0.5);
    border-top-color: rgba(0, 0, 0, 0.5);
    border-bottom-color: rgba(0, 0, 0, 0.5);
    margin-top: 4px;
    margin-right: 4px;
    margin-bottom: 4px;
    margin-left: 4px;
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    align-items: center;
    justify-content: flex-start;
    flex-direction: row;
}

.warning-item-icon {
    background-size: 20px 20px;
    background-image: url("../Icons/warning.png");
    width: 20px;
    height: 20px;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
}

.warning-item-text {
    white-space: normal;
    max-width: 95%;
}

.settings-group-content {
    flex-direction: row;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    align-items: center;
}

.settings-group-warning {
    flex-grow: 1;
    background-image: url("../Icons/warning.png");
    width: 20px;
    height: 20px;
    margin-top: 3px;
    margin-right: 3px;
    margin-bottom: 3px;
    margin-left: 3px;
}

/* Reason shown under the interpreter checks when it is not ready to build. Indented to the
   text column of the rows above, wrapped, and dimmed so it reads as an explanation rather
   than as another check. */
.settings-item-message {
    margin-left: 24px;
    margin-right: 3px;
    margin-top: 2px;
    margin-bottom: 4px;
    white-space: normal;
    color: rgb(180, 180, 180);
    font-size: 11px;
}
